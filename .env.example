# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=3000
NODE_ENV=development

# MongoDB connection string (local or Atlas). The app always uses the database
# "comp3123_assignment1", so you do not need to put the database name in the URI.
#   Local:  mongodb://127.0.0.1:27017
#   Atlas:  mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# JWT - use a long random string (generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Password hashing cost (bcrypt salt rounds)
BCRYPT_SALT_ROUNDS=10

# Rate limiting (per client IP, per window)
RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=5
SIGNUP_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_DIR=logs
